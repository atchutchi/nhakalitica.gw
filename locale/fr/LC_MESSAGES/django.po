msgid "Uma comunidade privada que liga profissionais dentro e fora da Guiné-Bissau. Colabora, partilha conhecimento e cria oportunidades."
msgstr "Une communauté privée qui relie les professionnels en Guinée-Bissau et à l’étranger. Collaborez, partagez vos connaissances et créez des opportunités."

msgid "Rede privada e segura"
msgstr "Réseau privé et sécurisé"

msgid "Adesão por aprovação"
msgstr "Adhésion sur approbation"

msgid "Comunidade de confiança"
msgstr "Communauté de confiance"

msgid "Para quem é a Kalitica?"
msgstr "À qui s’adresse Kalitica ?"

msgid "Profissionais na Guiné-Bissau, na diáspora guineense e pessoas com ligação relevante ao país."
msgstr "Professionnels en Guinée-Bissau, membres de la diaspora et personnes ayant un lien pertinent avec le pays."

msgid "Saber mais sobre a nossa missão"
msgstr "En savoir plus sur notre mission"

msgid "Como funciona a adesão"
msgstr "Comment fonctionne l’adhésion"

msgid "A candidatura será analisada pela equipa Kalitica. Receberás uma resposta por email."
msgstr "La candidature sera examinée par l’équipe Kalitica. Vous recevrez une réponse par email."

msgid "Ver tipos de adesão"
msgstr "Voir les types d’adhésion"

msgid "Bem-vindo de volta à Kalitica."
msgstr "Bienvenue à nouveau chez Kalitica."

msgid "Manter sessão iniciada"
msgstr "Rester connecté"

msgid "Esqueceu a palavra-passe?"
msgstr "Mot de passe oublié ?"

